# SaaqiFolio - Apache Configuration (.htaccess)
# Clean Extensionless URLs + Anti-Cache Headers

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. 301 Redirect browser from direct .php requests to clean extensionless URLs (only for GET)
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.php(?:[?\s]|$) [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2. Public profile clean URL: /p/username -> /p.php?slug=username
  RewriteRule ^p/([a-zA-Z0-9_-]+)/?$ p.php?slug=$1 [L,QSA]

  # 3. Rewrite extensionless URLs to .php files if matching file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# Prevent browser from aggressively caching dynamic PHP pages
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Security: prevent directory listing
Options -Indexes
